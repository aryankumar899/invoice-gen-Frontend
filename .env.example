# Frontend Environment Variables
# Copy to .env.local for local development

# Backend API URL — change to http://localhost:5000 for local dev
VITE_API_URL=http://localhost:5000

# EmailJS (sends username + password after sign up / sign in)
# Template To Email must be {{to_email}}
# Use the same service/template/public key as the backend
VITE_EMAILJS_SERVICE_ID=service_by7rc99
VITE_EMAILJS_TEMPLATE_ID=template_qgk2bcn
VITE_EMAILJS_TEMPLATE_CREDENTIALS=template_qgk2bcn
VITE_EMAILJS_TEMPLATE_RESET=template_enrb6um
VITE_EMAILJS_PUBLIC_KEY=your_public_key
